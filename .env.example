# ============================================================================
# VIM POS — variables de entorno. Copia este archivo a .env.local y rellena.
# .env.local está en .gitignore: los SECRETOS nunca se commitean ni se comparten.
# ============================================================================

# ---- PÚBLICAS (seguras en cliente: apps pos / admin / platform) ----
# Las da el dashboard de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"

# ---- SECRETAS (SOLO server-side: platform + Edge Functions) ----
# NUNCA en apps/pos ni apps/admin de cliente. NUNCA en git.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon key>"        # Edge Functions: gateway + clientes con el JWT del llamante
SUPABASE_SERVICE_ROLE_KEY=""          # ignora RLS — máximo cuidado (solo platform + functions)
SUPABASE_JWT_SECRET=""                # firma los tokens de empleado (pin-login)

# ---- Edge Functions: secretos propios (no admiten prefijo SUPABASE_) ----
# Local: supabase/functions/.env  ·  Cloud: `supabase secrets set NOMBRE=valor`
VIM_JWT_SECRET=""                     # = SUPABASE_JWT_SECRET; pin-login acuña el JWT de empleado con él

# ---- CFDI / PAC (F8) — necesario en GO-LIVE para timbrar de verdad ----
# Orden: Facturama si hay usuario Y contraseña, luego Facturapi si hay llave, y nada más.
# SIN NINGUNO NO SE TIMBRA: se devuelve PAC_NO_CONFIGURADO y el CFDI se marca en ERROR.
# Es a propósito — antes caía al mock, que simula un timbrado exitoso y le manda al cliente un
# comprobante que no existe ante el SAT. Ver docs/decisiones/0009.
#
# Facturama es el PRINCIPAL: lleva el emisor en el payload, así que una sola credencial timbra a
# nombre de cualquier cliente (Multiemisor). Facturapi deduce el emisor de su llave, o sea que con
# una llave global TODO saldría con NUESTRO RFC — sirve de respaldo, nunca de principal.
FACTURAMA_API_USER=""
FACTURAMA_API_PASSWORD=""
# Sin esta URL se apunta al SANDBOX a propósito: un despliegue a medias timbra en pruebas y no
# contra el SAT de verdad. En producción: https://api.facturama.mx
FACTURAMA_BASE_URL=""
FACTURAPI_API_KEY=""                  # Respaldo. Subir el CSD al emisor antes.

# Solo desarrollo. "1" habilita el PAC de mentira cuando no hay credenciales reales.
# NUNCA en producción: genera CFDI que parecen válidos y no lo son.
# PAC_PERMITIR_MOCK="1"

# ---- Plataforma de provisioning (F10) ----
# Secreto compartido que protege la Edge Function provisionar-tenant y las rutas /api/* de
# apps/platform. Genera uno fuerte (p.ej. `openssl rand -hex 32`). Solo lo conoce VIM.
# Fail-closed: si falta, el provisioning queda deshabilitado (503).
PLATFORM_PROVISION_KEY=""

# SEC CN-003 — allowlist de IPs que pueden hablar con /api/* de apps/platform. Vacío => sin
# restricción por IP (solo la clave + el límite de 5 intentos/15 min). Es el control DURO del
# panel mientras la auth siga siendo una clave compartida: ponle las IPs de salida de VIM.
# Separadas por comas, tal cual llegan en X-Forwarded-For. Ej: "189.203.11.4,189.203.11.5"
PLATFORM_IP_ALLOWLIST=""

# ---- CORS de las Edge Functions (SEC CN-004) ----
# Lista separada por comas de orígenes permitidos en producción. Vacío => CORS '*' (dev).
# En prod fijarlo (vía `supabase secrets set`):
# VIM_CORS_ORIGINS="https://pos.vimpos.com.mx,https://admin.vimpos.com.mx,https://platform.vimpos.com.mx"
VIM_CORS_ORIGINS=""

# ---- Para vincular el CLI al proyecto cloud (no es runtime) ----
# SUPABASE_PROJECT_REF="<project-ref>"
# DB password: se usa en `supabase link`, no se guarda aquí.
