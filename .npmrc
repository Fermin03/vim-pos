# SEC CN-012 (Cyber Neo) — pinnear el registro evita dependency confusion:
# que un paquete público que squattee @vim/* sea resuelto desde otro registro.
registry=https://registry.npmjs.org/
@vim:registry=https://registry.npmjs.org/

# Instalaciones reproducibles: falla si el lockfile no coincide (CI/prod).
# (En local, `pnpm install` normal sigue funcionando; esto endurece CI.)
auto-install-peers=true
strict-peer-dependencies=false

# Scripts de instalación de dependencias: SOLO los de la allow-list `pnpm.onlyBuiltDependencies`
# del package.json raíz (hoy únicamente esbuild, el único paquete del árbol con postinstall).
# Este comentario decía que ya se bloqueaban "salvo allow-list", pero la allow-list no existía y
# pnpm 9 ejecutaba el postinstall de cualquier dependencia. Con `onlyBuiltDependencies` presente,
# pnpm ignora los scripts de todo lo que no esté en la lista. Para sumar un paquete, justifícalo
# y verifica con `pnpm install --frozen-lockfile` + `pnpm -r build`. (Auditoría 30/09/2026, E-6.)
