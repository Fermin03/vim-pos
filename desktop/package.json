{
  "name": "vim-pos-desktop",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "VIM POS · Punto de venta para restaurantes",
  "author": "VIM Marketing <hola@vimpos.com.mx>",
  "main": "src/main.mjs",
  "scripts": {
    "verify": "node src/verify-e2e.mjs",
    "verify:sync": "node src/verify-sync.mjs",
    "verify:lealtad-pull": "node src/verify-lealtad-pull.mjs",
    "verify:lealtad-canje": "node src/verify-lealtad-canje.mjs",
    "verify:migraciones": "node src/verify-migraciones.mjs",
    "verify:push": "node src/verify-push.mjs",
    "verify:dia": "node src/verify-dia.mjs",
    "verify:cloud": "node src/verify-cloud.mjs",
    "verify:hub": "node src/verify-hub.mjs",
    "backend": "node src/backend.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:kds-ui": "node scripts/build-kds-ui.mjs",
    "start": "electron .",
    "start:cocina": "electron . --role=cocina",
    "backup": "node scripts/backup-cli.mjs",
    "restore": "node scripts/restore.mjs",
    "release-manifest": "node scripts/release-manifest.mjs",
    "verify:robustez3": "node src/verify-robustez3.mjs",
    "dist": "npm run build:ui && npm run build:kds-ui && node scripts/dist.mjs",
    "verify:concurrencia": "node src/verify-concurrencia.mjs",
    "verify:electron": "electron src/verify-electron.mjs",
    "verify:push-aislado": "node src/verify-push-aislado.mjs",
    "verify:ticket-impreso": "node src/verify-ticket-impreso.mjs",
    "verify:parada": "node src/verify-parada.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "carga:plantilla": "node scripts/capturar-plantilla.mjs",
    "carga": "node scripts/carga-nube.mjs",
    "resincronizar-cortes": "node scripts/resincronizar-cortes.mjs",
    "smokes": "node scripts/smokes.mjs"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vimpos.desktop",
    "productName": "VIM POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.mjs",
      "!src/verify-*.mjs",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../supabase/migrations",
        "to": "migrations"
      },
      {
        "from": "../supabase/seed.sql",
        "to": "seed.sql"
      },
      {
        "from": "sql",
        "to": "sql"
      },
      {
        "from": "bin/postgrest.exe",
        "to": "bin/postgrest.exe"
      },
      {
        "from": "node_modules/@embedded-postgres/windows-x64/native/bin",
        "to": "pg-bin"
      },
      {
        "from": "pos-ui",
        "to": "pos-ui"
      },
      {
        "from": "kds-ui",
        "to": "kds-ui"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
