{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*(text/markdown|text/x-markdown).*"
        }
      ],
      "destination": "/index.md",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/funciones.html",
      "destination": "/funciones",
      "permanent": true
    },
    {
      "source": "/sin-internet.html",
      "destination": "/sin-internet",
      "permanent": true
    },
    {
      "source": "/precios.html",
