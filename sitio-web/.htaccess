# ============================================================================
# vimpos.com.mx — Apache (Hostinger)
#
# Se sube a `public_html/` junto con el resto. Ojo: empieza con punto, así que
# el cliente de FTP puede estar ocultándolo. Si el sitio se ve pero no fuerza
# HTTPS, lo primero que hay que revisar es si este archivo llegó.
#
# Lo que NO está aquí, a propósito:
#
#   · HSTS (`Strict-Transport-Security`). Es correcto ponerlo, pero es la única
#     cabecera de esta lista que NO se puede deshacer: el navegador la recuerda
#     durante el max-age aunque la quites del servidor. Con el dominio recién
#     apuntado, un certificado mal renovado dejaría el sitio inaccesible sin
#     forma de arreglarlo desde aquí. Se activa cuando lleve unos meses estable.
#   · Content-Security-Policy. Desde que las tipografías se auto-alojan, el
#     ÚNICO destino externo del sitio es la Edge Function de Supabase, así que
#     escribir la CSP ya es viable de verdad — antes había que abrirle la puerta
#     a dos dominios de Google además. Sigue sin ponerse porque una CSP mal
#     escrita se ve solo en producción y merece su propia pasada con la consola
#     abierta; el borrador sería algo como:
#       default-src 'self'; connect-src 'self' https://*.supabase.co;
#       img-src 'self' data:; style-src 'self'; script-src 'self'
#     Ojo con los `style="..."` en línea de las páginas: obligarían a
#     'unsafe-inline' o a moverlos al CSS, que es lo correcto.
# ============================================================================

# ── HTTPS y dominio único ───────────────────────────────────────────────────
# Una sola redirección encadenada en vez de dos saltos: www + http llega al
# apex con https en un solo 301.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://vimpos.com.mx%{REQUEST_URI} [R=301,L]
</IfModule>

# ── URLs sin .html, alias y Markdown ────────────────────────────────────────
# En Vercel esto son `redirects` y `rewrites` en vercel.json —`cleanUrls` se
# apagó a propósito, ver DESPLIEGUE.md—; aquí hay que escribirlo.
#
# El orden de los bloques es el orden en que Apache los evalúa, y no es
# intercambiable: la negociación de Markdown va ANTES de servir el .html,
# porque si el .html se sirve primero ya no hay nada que negociar.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Si alguien llega con .html, se le manda a la limpia.
  RewriteCond %{THE_REQUEST} "\s/+(.+)\.html[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2. Los alias en inglés, que existen para las herramientas que buscan
  #    /about, /contact y /privacy por convención. Son la misma página: el
  #    canonical de cada una apunta a su dirección en español.
  RewriteRule ^about/?$   /nosotros         [L]
  RewriteRule ^contact/?$ /contacto         [L]
  RewriteRule ^privacy/?$ /aviso-privacidad [L]
  RewriteRule ^terms/?$   /terminos         [L]

  # 3. Markdown, si el cliente lo pide con la cabecera Accept. La misma
  #    dirección devuelve HTML a un navegador y Markdown a un agente; por eso
  #    más abajo se manda `Vary: Accept`, sin el cual una caché intermedia le
  #    puede dar a uno lo del otro.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/index.md -f
  RewriteRule ^$ /index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.md -f
  RewriteRule ^(.+?)/?$ /$1.md [L]

  # 4. Y si no, la dirección limpia sirve el .html sin que se note.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ── Página de error ─────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Cabeceras ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # El navegador no adivina el tipo de archivo. Corta la vía por la que un
  # archivo subido se acaba ejecutando como script.
  Header always set X-Content-Type-Options "nosniff"

  # Nadie mete el sitio en un iframe ajeno.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Al salir a otro dominio se manda el origen, no la URL completa. Aquí no
  # hay nada sensible en las rutas, pero es gratis y es el valor correcto.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # El sitio no usa cámara, micrófono ni ubicación. Decirlo cierra la puerta
  # por si algún día se cuela un script de terceros que sí quiera pedirlos.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # La misma dirección devuelve HTML o Markdown según la cabecera Accept. Sin
  # este Vary, una caché compartida guarda la primera de las dos versiones que
  # pase por ella y se la sirve a todo el mundo.
  <FilesMatch "\.(html|md)$">
    Header always set Vary "Accept, Accept-Encoding"
  </FilesMatch>
</IfModule>

# ── Caché ───────────────────────────────────────────────────────────────────
# Los assets llevan un año; el HTML, una hora.
#
# Un año en CSS y JS es correcto SOLO porque el sitio se despliega entero y a
# mano: si algún día se automatiza, hay que ponerle una versión al nombre del
# archivo (`vim.abc123.css`) antes de tocar esto. Sin eso, un visitante que ya
# estuvo aquí se queda con el CSS viejo hasta que caduque.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # El HTML corto: es lo que cambia cuando se corrige un precio o una frase, y
  # es justo lo que no puede quedarse pegado en el navegador de un prospecto.
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

# ── Compresión ──────────────────────────────────────────────────────────────
# Solo texto. Comprimir un WebP o un PNG gasta CPU para no ganar nada.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Tipos que Apache viejo no siempre conoce ────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp     .webp
  AddType font/woff2     .woff2
  AddType application/manifest+json .webmanifest

  # Los gemelos en Markdown. Sin esto Apache los manda como
  # application/octet-stream y el navegador los descarga en vez de mostrarlos —
  # y un agente que pidió text/markdown recibe algo que no es lo que pidió.
  AddType text/markdown  .md
  AddCharset UTF-8       .md
</IfModule>

# ── Nada de listar carpetas ─────────────────────────────────────────────────
Options -Indexes

# ── Lo que no se publica ────────────────────────────────────────────────────
# `_patron.html` y `_capturas/` son herramientas de desarrollo. Lo correcto es
# no subirlos; esto es el segundo cerrojo por si se suben sin querer.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_ - [F,L]
</IfModule>

# ── Tipografías ─────────────────────────────────────────────────────────────
# Se auto-alojan desde que se quitó Google Fonts. `Access-Control-Allow-Origin`
# hace falta aunque se sirvan del mismo dominio: el `<link rel="preload"
# as="font">` va con `crossorigin` —lo exige la especificación para fuentes— y
# sin esta cabecera el navegador descarta la precarga y la vuelve a pedir.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
