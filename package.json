{
  "name": "vim-pos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "_comment_test_functions": "supabase/functions es codigo Deno y no esta en el workspace de pnpm; sus modulos puros se prueban con el runner de Node",
    "auditar:consultas": "node scripts/auditar-consultas.mjs",
    "test:functions": "node --test --experimental-strip-types supabase/functions/_shared/pac/*.test.ts",
    "_comment_sitio": "sitio-web es HTML estatico sin build ni dependencias; se genera y se prueba con Node pelado",
    "sitio:generar": "node sitio-web/_agentes/generar.mjs",
    "sitio:servir": "node sitio-web/_agentes/servidor.mjs",
    "sitio:indexnow": "node sitio-web/_agentes/indexnow.mjs",
    "test:sitio": "node --test sitio-web/_agentes/pruebas.test.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.0": ">=0.35.0"
    }
  }
}
